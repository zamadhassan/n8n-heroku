# ============================================
# n8n Heroku Deployment - Environment Example
# ============================================
# Copy this file to .env and fill in values.
# DO NOT commit .env to Git!
# ============================================

# REQUIRED: Set a random encryption key (min 32 chars)
# Generate one: openssl rand -hex 20
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# REQUIRED: Your Heroku app URL (replace <app-name>)
WEBHOOK_URL=https://<app-name>.herokuapp.com

# REQUIRED: Your Heroku app hostname (no protocol)
N8N_HOST=<app-name>.herokuapp.com

# REQUIRED: Protocol (Heroku uses https)
N8N_PROTOCOL=https

# REQUIRED: Environment
NODE_ENV=production

# OPTIONAL: Timezone (default UTC)
# See https://momentjs.com/timezone/
GENERIC_TIMEZONE=UTC

# OPTIONAL: n8n config
# N8N_LOG_LEVEL=info
# EXECUTIONS_DATA_PRUNE=true
# EXECUTIONS_DATA_MAX_AGE=168
